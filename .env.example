# Copy this file to .env and fill in one provider. Never commit .env.
# Model names below are examples; check your provider's model list for current IDs.

# --- DeepSeek ---
BASE_URL=https://api.deepseek.com
API_KEY=sk-your-deepseek-key
MODEL=deepseek-chat

# --- OpenRouter (any model, one key) ---
# BASE_URL=https://openrouter.ai/api/v1
# API_KEY=sk-or-your-key
# MODEL=anthropic/claude-sonnet-4.5

# --- OpenAI ---
# BASE_URL=https://api.openai.com/v1
# API_KEY=sk-your-key
# MODEL=gpt-4.1

# --- Gemini (OpenAI-compatible endpoint) ---
# BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
# API_KEY=your-gemini-key
# MODEL=gemini-2.5-flash

# --- Ollama cloud (key from https://ollama.com/settings/keys) ---
# BASE_URL=https://ollama.com/v1
# API_KEY=your-ollama-key
# MODEL=kimi-k2.7-code

# --- Local (Ollama / LM Studio) ---
# BASE_URL=http://localhost:11434/v1
# API_KEY=ollama
# MODEL=qwen2.5-coder

# --- Profiles: keep more than one provider in this file ---
# Suffix a block with _<NAME> and select it with `kyklos --profile <name>` (or KYKLOS_PROFILE=<name>).
# The unsuffixed block above is the default profile, used when no profile is given, so a file
# written before profiles existed keeps working unchanged.
# A profile reads only its own suffixed names. Nothing is inherited from the default block: a
# profile that sets BASE_URL_LOCAL must set API_KEY_LOCAL too, rather than borrowing the default
# key and posting one provider's credential to another provider's host.
# Each profile also remembers its own /model pick, in ~/.kyklos/settings.json.
# BASE_URL_LOCAL=http://localhost:11434/v1
# API_KEY_LOCAL=ollama
# MODEL_LOCAL=qwen3-32k
# CONTEXT_WINDOW_LOCAL=32768

# Optional: route subagents (`task`) to a faster or cheaper model on the same provider.
# Can also be picked interactively with `/submodel` (remembered in ~/.kyklos/settings.json)
# or overridden for one run with `kyklos --submodel <name|same>`.
# SUBAGENT_MODEL=minimax-m3.1-flash
# SUBAGENT_EFFORT=low

# Whether the model takes images (read_file on a PNG/JPEG/WebP, or @path/to/image in a message).
# Ollama says per model, so leave this unset there. No other provider does, so Kyklos assumes text
# only: set VISION=1 for a model that takes images, or VISION=0 to keep images out regardless.
# Forcing VISION=1 on an Ollama model without vision isn't refused: the image is silently dropped,
# and Kyklos warns the first time it sends one to such a model.
# Like the other provider settings, a profile takes its own: VISION_LOCAL=1.
# VISION=1

# Image generation: the generate_image tool, which makes an image from a prompt and saves it in the
# workspace (sprites, icons, concept art). It is a second provider, set up here on its own: it never
# uses the chat provider's BASE_URL or API_KEY, and profiles don't change it. Leave these unset and
# the tool doesn't exist. Every call asks you first, since it sends the prompt to this host and
# image models usually bill per image. It is never offered in plan mode, to subagents or in --eval.
#   IMAGE_API=images  the OpenAI Images API (/images/generations): OpenAI, xAI, Together, ...
#   IMAGE_API=chat    an image model served through chat completions, as OpenRouter does
# IMAGE_BASE_URL=https://api.openai.com/v1
# IMAGE_API_KEY=sk-...
# IMAGE_MODEL=gpt-image-1
# IMAGE_API=images
# IMAGE_SIZE=1024x1024
#
# OpenRouter instead:
# IMAGE_BASE_URL=https://openrouter.ai/api/v1
# IMAGE_API_KEY=sk-or-...
# IMAGE_MODEL=google/gemini-2.5-flash-image
# IMAGE_API=chat

# A persona to start in: a prompt layer from ~/.kyklos/personas/<name>.md, chosen by the user and
# never read from a workspace. Switch or clear it with /persona, or for one run with
# `kyklos --persona <name|off>`.
# KYKLOS_PERSONA=chief

# Your model's context window in tokens. Kyklos compacts the conversation at 75% of it.
# On Ollama cloud it's detected automatically from the model (e.g. 1M for minimax-m3.1-flash).
# Set it to override that: lower keeps turns faster and cheaper. For other providers it
# defaults to 128000. For local Ollama, set it to the server's context length
# (OLLAMA_CONTEXT_LENGTH): /api/show reports the model's trained maximum, not the num_ctx the
# server actually serves, so it is not detected for you and the default will be far too large.
# CONTEXT_WINDOW=128000

# The size a conversation may reach before Kyklos compacts it, in tokens (default 100000).
# Kyklos also compacts at 75% of the context window, and uses whichever comes first. The cap matters
# on big-window models: every step re-sends the whole conversation, so what a turn costs depends on
# how much context each step carries, not on how much window is left over. On a 1M-token model,
# without this, nothing would prune until 750k. Raise it to carry more context per step at more cost
# per step; lower it to spend less and re-fetch more.
# COMPACT_ABOVE=100000

# How many model turns one request may take before Kyklos stops and hands back to you. The default
# is 50. Raise it for a big refactor that legitimately needs more; lower it while you're trying out
# a model that tends to loop. Hitting it isn't a failure: the conversation is kept, so "continue"
# picks up where it stopped.
# MAX_STEPS=50

# Stream the API call (default on). This is transport, not display: Kyklos reassembles the stream
# before anything else sees it, so nothing on screen changes either way. On keeps bytes moving over
# the socket for the whole generation, which stops an upstream proxy from reading a long reply as a
# dead connection and closing it. Set STREAM=0 if a provider's delta format misbehaves, or to get
# exact token counts from a provider that drops usage when streaming (Kyklos says so once if yours
# does).
# STREAM=1

# Localhost ports a command may use inside the macOS sandbox, for a dev server or a browser test run
# against one. Off by default: the sandbox otherwise denies all networking, loopback included, so
# even binding 127.0.0.1 fails. Single ports from 1024 up, comma-separated (no ranges). This limits
# which ports, not which interface: a server that listens on every interface (0.0.0.0, the default
# for Express and `python -m http.server`) is reachable from your network on that port while it
# runs, so have it bind 127.0.0.1. Whatever else listens on a listed port is reachable too: list the
# ones your project uses and nothing else.
# KYKLOS_SANDBOX_PORTS=5173,4173

# The safer variant: commands may only CONNECT to these localhost ports, and nothing in the sandbox
# can listen on any port, so nothing is exposed. For a server you start yourself in another
# terminal (`npm run dev`) and a browser test or curl that talks to it. The same rules apply:
# single ports from 1024 up, no ranges, and whatever listens on that port is reachable from the
# sandbox. A port in both settings gets the larger grant.
# KYKLOS_SANDBOX_CONNECT=5173

# Folder the agent works in. Leave this unset to use Kyklos from any folder:
# it then works in the directory you launch it from.
# WORKSPACE=C:\path\to\kyklos-harness\sandbox
