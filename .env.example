# Copy this file to .env and fill in one provider. Never commit .env.
# Model names below are examples; check your provider's model list for current IDs.

# --- DeepSeek ---
BASE_URL=https://api.deepseek.com
API_KEY=sk-your-deepseek-key
MODEL=deepseek-chat

# --- OpenRouter (any model, one key) ---
# BASE_URL=https://openrouter.ai/api/v1
# API_KEY=sk-or-your-key
# MODEL=anthropic/claude-sonnet-4.5

# --- OpenAI ---
# BASE_URL=https://api.openai.com/v1
# API_KEY=sk-your-key
# MODEL=gpt-4.1

# --- Gemini (OpenAI-compatible endpoint) ---
# BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
# API_KEY=your-gemini-key
# MODEL=gemini-2.5-flash

# --- Ollama cloud (key from https://ollama.com/settings/keys) ---
# BASE_URL=https://ollama.com/v1
# API_KEY=your-ollama-key
# MODEL=kimi-k2.7-code

# --- Local (Ollama / LM Studio) ---
# BASE_URL=http://localhost:11434/v1
# API_KEY=ollama
# MODEL=qwen2.5-coder

# Your model's context window in tokens (default 128000). Kyklos summarizes older
# turns when the conversation passes 75% of it. Set it lower for small local models.
# CONTEXT_WINDOW=128000

# Folder the agent works in. Defaults to the directory you launch from.
# WORKSPACE=C:\path\to\kyklos-harness\sandbox
